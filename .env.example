# Copy this file to ".env" and fill in your key.  Never commit ".env".

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# "openrouter/free" automatically picks from OpenRouter's current free models.
# Free model IDs change often - for steadier answers use a paid model,
# e.g. OPENROUTER_MODEL=openai/gpt-4o-mini  (browse https://openrouter.ai/models)
OPENROUTER_MODEL=openrouter/free

# Optional: comma-separated backup models, tried in order if the first one fails.
# OPENROUTER_FALLBACK_MODELS=

# Optional tuning
# TEMPERATURE=0.5
# MAX_TOKENS=500
# RATE_LIMIT_PER_MINUTE=20
# PORT=5000
# FLASK_DEBUG=1

# Optional: your public site URL (shown on openrouter.ai) and extra allowed origins
# SITE_URL=http://127.0.0.1:5000
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
